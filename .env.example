# Database
# MongoDB connection string. Create this in MongoDB Atlas or your MongoDB provider.
MONGO_URI=mongodb+srv://klayne_app_user:fake-password@cluster0.example.mongodb.net/klayne?retryWrites=true&w=majority

# Authentication
# Long random string used to sign JWT cookies. Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-long-random-secret

# App Config
# Runtime environment. Use development locally and production on Render.
NODE_ENV=development

# Backend port used by Express locally. Render sets PORT automatically in production.
PORT=5000

# Cloudinary
# Cloudinary cloud name from your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=demo-cloud

# Cloudinary API key from your Cloudinary dashboard.
CLOUDINARY_API_KEY=123456789012345

# Cloudinary API secret from your Cloudinary dashboard. Keep this server-side only.
CLOUDINARY_API_SECRET=fake_cloudinary_api_secret

# Firebase Admin
# Firebase service account JSON for backend Google token verification. Store as one-line JSON in production env vars.
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"klayne-demo","private_key_id":"fake","private_key":"-----BEGIN PRIVATE KEY-----\nfake\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@example.iam.gserviceaccount.com","client_id":"1234567890","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk@example.iam.gserviceaccount.com","universe_domain":"googleapis.com"}

# Web Push
# Public VAPID key used by browsers when subscribing to push notifications.
VAPID_PUBLIC_KEY=BA_fake_public_vapid_key

# Private VAPID key used by the backend to sign Web Push notifications.
VAPID_PRIVATE_KEY=fake_private_vapid_key

# Firebase Client
# Public Firebase web app config used by the Vite frontend for Google sign-in.
VITE_FIREBASE_API_KEY=fake-firebase-web-api-key

# Firebase Auth domain, usually <project-id>.firebaseapp.com.
VITE_FIREBASE_AUTH_DOMAIN=klayne-demo.firebaseapp.com

# Firebase project id.
VITE_FIREBASE_PROJECT_ID=klayne-demo

# Firebase storage bucket from the Firebase web app config.
VITE_FIREBASE_STORAGE_BUCKET=klayne-demo.appspot.com

# Firebase messaging sender id from the Firebase web app config.
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012

# Firebase app id from the Firebase web app config.
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
